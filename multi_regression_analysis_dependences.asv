plot(Y-resi_KHW_all_x,resi_KHW_all_x,'.k')
title('Residuos vs fitted KJHBWO_{xyz}');ylim([-0.1,0.1])

subplot(3,4,9)
semilogy(abs(QR_x),'or')
hold on
semilogy(abs(QR_KHW_x),'*b')
