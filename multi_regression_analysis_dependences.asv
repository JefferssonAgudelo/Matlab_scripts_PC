model_names = {'Xx','Xy','Xz',...
               'KHW_Xx','KHW_Xy','KHW_Xz',...
               'comp_Xx','comp_Xy','comp_Xz',...
               'KHW_all_Xx','KHW_all_Xy','KHW_all_Xz',...
               'mod5_Xx','mod5_Xy','mod5_Xz'};

% --- Initialize containers
Pearson_coeff_struct = struct();

% --- Load values into structs dynamically
for i = 1:length(model_names)
    model = model_names{i};
    Pearson_coeff_struct.(model) = eval(['pearson_coeff_' model]);
end

% --- Build R² Table (single-row table)
Pearson_coeff_table = array2table(zeros(1, numel(model_names)), 'VariableNames', model_names);
for i = 1:length(model_names)
    model = model_names{i};
    Pearson_coeff_table{1, model} = Pearson_coeff_struct.(model);
end


% --- Display tables
disp('--- Coefficients Table ---');
disp(Pearson_coeff_table);

