% % % ax = gca; ax.TickLabelInterpreter = 'latex';ax.XLabel.Interpreter='latex';ax.YLabel.Interpreter='latex';
% % % %ylabel('$\Sigma \tau_y$','Interpreter','latex')
% % % xlabel('$|Yfit|$','Interpreter','latex')
% % % ylabel('$|Residuals|$','Interpreter','latex')
% % % title('$\Sigma \tau = a_{0} + a_{1}KJ_{x} + ... + W\Omega_{z}n $','Interpreter','latex');
% % % %--------------------------------------------------------------------------

% This is where the information about the difference in the toy model
%--------------------------------------------------------------------------
Ymod = sqrt( (Yx).^2 + (Yy).^2 + (Yz).^2);
%--------------------------------------------------------------------------

a=min(abs(Ymod)); 
b=max(abs(Ymod));

% This is the part to check the residual plots using toy models to see how
% they look to understand what they are telling
%--------------------------------------------------------------------------
%--------------------------------------------------------------------------

% Important note!!! If the slope is small, of the order of 0.01 the tube
% extension is getting increased (the elongation at larger values) This is
% an effect of the small slope!
toy_slop = 0.01;

N = 50000;
%length(Yx)
% Normal
% distribution of x
xx0 = randn(1, N);
xx = a + (b-a).*xx0;
% distribution of y
yy0 = randn(1, N);
yy = a + (b-a).*yy0;
%distribution of residuals
resi_fake = randn(1, N);
resi_fake2 = a + (b-a).*resi_fake;
% comppute the fit
P = polyfit(xx,yy,1); Yxfit = P(1)*xx+P(2);
residx = (yy-Yxfit);
% y as a linear function of x which is a linspace
xx2=linspace(-2,2,N);
yy2 = toy_slop*xx2.^1 + resi_fake2;
P2 = polyfit(xx2,yy2,1); Yxfit2 = P2(1)*xx2+P2(2);
residx2 = (yy2-Yxfit2);



% % % With uniform distribution.
% % %a=-2; b=2;
% % %N = 50000;
% % %length(Yx)
% % % uniform
% % % distribution of x
% % xx0 = rand(1, N);
% % xx = a + (b-a).*xx0;
% % % distribution of y
% % yy0 = rand(1, N);
% % yy = a + (b-a).*yy0;
% % %distribution of residuals
% % resi_fake = randn(1, N);
% % resi_fake2 = a + (b-a).*resi_fake;
% % % comppute the fit
% % P = polyfit(xx,yy,1); Yxfit = P(1)*xx+P(2);
% % residx = (yy-Yxfit);
% % % y as a linear function of x which is a linspace
% % xx2=linspace(-2,2,N);
% % yy2 = toy_slop*xx2.^1 + resi_fake2;
% % P2 = polyfit(xx2,yy2,1); Yxfit2 = P2(1)*xx2+P2(2);
% % residx2 = (yy2-Yxfit2);



f27=figure(27);
subplot(2,3,1)
plot(xx,yy,'.b')
title('y vs x normal')
subplot(2,3,2)
%plot(Yxfit,residx + 2*max(abs(residx)),'*r')
plot(Yxfit,residx,'*r')
title('residuals normal')
%plot(resi_fake2,'.b')
subplot(2,3,3)
plot(abs(Yxfit),abs(residx),'.k')
%plot(resi_fake2,'.b')
title('abs(resi) vs abs(yfit) normal')
yscale log 
xscale log
subplot(2,3,4)
plot(xx2,yy2,'.b')
title('y vs x normal square')
subplot(2,3,5)
%plot(Yxfit,residx + 2*max(abs(residx)),'*r')
plot(Yxfit2,residx2,'*r')
title('residuals vs yfit normal linear')
%plot(resi_fake2,'.b')
subplot(2,3,6)
plot(abs(Yxfit2),abs(residx2),'.k')
%plot(resi_fake2,'.b')
title('abs(resi) vs abs(yfit) normal linear')
yscale log
xscale log



nbins=60; fs=16; x0=45;y0=54;xx1=1300;yy1=850;

% This is to see if there is any threshold that can tell something about
% the distribution 
%--------------------------------------------------------------------------
%
f33=figure(33)
x3=linspace(min(Ymod),max(Ymod));
a = 0.011; b = 1; c = 0.001;
y3 = 1 + a./(x3 - c).^b;
f44=figure(44)
loglog(x3,y3,'r')
hold on
b = 0.9; y3 = 1 + a./(x3 - c).^b;
loglog(x3,y3,'b')
b = 0.8; y3 = 1 + a./(x3 - c).^b;
loglog(x3,y3,'k')
yline([1],'--k',LineWidth=1.5)
hold off

y3 = 1 + a./((x3) - c).^b;
loglog((x3),y3,'r','LineWidth',2)
hold on
y4 = 1 - a./((x3) - c).^b;
loglog((x3),y4,'b','LineWidth',2)
hold off
%ylim([0.1 10])
%xlim([1e-2 1e4])



f55=figure(55)
set(gcf,'position',[x0,y0,xx1,2*yy1/4.5])
subplot(2,4,1)
plot(xx2,yy2,'.b')
title('y vs x normal distri')
subplot(2,4,2)
plot(Yxfit2,residx2,'.b')
title('resi vs Yfit')
subplot(2,4,3)
plot(yy2,residx2,'.b')
title('resi vs Y')
subplot(2,4,4)
plot(xx2,residx2,'.b')
title('resi vs x')

subplot(2,4,5)
loglog(abs(xx2),abs(yy2),'.b')
title('|y| vs |x| normal distri')

subplot(2,4,6)
%loglog(abs(Yxfit2),abs(residx2/sqrt(mean(yy2.^2))),'.b')
loglog(abs(Yxfit2),abs(residx2/sqrt(mean(yy2.^2))),'.b')
title('|resi/Y_{rms}| vs |Yfit|')
yline([1],'--k',LineWidth=1.5)
ylim([1e-5, 10])

subplot(2,4,7)
loglog(abs(yy2),abs(residx2/sqrt(mean(yy2.^2))),'.b')
loglog(abs(yy2),abs(residx2/abs((yy2))),'.b')
title('|resi/Y_{rms}| vs |Y|')
hold on

%x3=log10([1e-4 1e2]); y3=-(1/2)*x3 + 0*1.4;
%loglog(10.^x3,10.^y3,'--k','LineWidth',2)

y3 = 1 - 1/xx2';
loglog(xx2,y3)
yline([1],'--k',LineWidth=1.5)
%ylim([1e-5 10])

%xlim([0.06 52])
%txt = '$k_{\perp} \sim k_{\parallel}^{3/2}$';
%txt2 = '$k_{\perp} \sim k_{\parallel}$';
hold off

subplot(2,4,8)
loglog(abs(xx2),abs(residx2./sqrt(mean(yy2.^2))),'.b')
title('|resi/Y_{rms}| vs |x|')
yline([1],'--k',LineWidth=1.5)
ylim([1e-5 10])


%a=-2; b=2;
%N = 50000;
%length(Yx)
% uniform
% distribution of x
xx0 = rand(1, N);
xx = a + (b-a).*xx0;
% distribution of y
yy0 = rand(1, N);
yy = a + (b-a).*yy0;
%distribution of residuals
resi_fake = randn(1, N);
resi_fake2 = a + (b-a).*resi_fake;
% comppute the fit
P = polyfit(xx,yy,1); Yxfit = P(1)*xx+P(2);
residx = (yy-Yxfit);
% y as a linear function of x which is a linspace
xx2=linspace(-2,2,N);
yy2 = toy_slop*xx2.^1 + resi_fake2;
P2 = polyfit(xx2,yy2,1); Yxfit2 = P2(1)*xx2+P2(2);
residx2 = (yy2-Yxfit2);


f56=figure(56)
set(gcf,'position',[x0,y0,xx1,2*yy1/4.5])
subplot(2,4,1)
plot(xx2,yy2,'.b')
title('y vs x normal distri')
subplot(2,4,2)
plot(Yxfit2,residx2,'.b')
title('resi vs Yfit')
subplot(2,4,3)
plot(yy2,residx2,'.b')
title('resi vs Y')
subplot(2,4,4)
plot(xx2,residx2,'.b')
title('resi vs x')
subplot(2,4,5)
loglog(abs(xx2),abs(yy2),'.b')
title('|y| vs |x| normal distri')
subplot(2,4,6)
loglog(abs(Yxfit2),abs(residx2/sqrt(mean(yy2.^2))),'.b')
hold on
x3=linspace(min(Ymod),max(Ymod));
a = 0.011; b = 1; c = 0.001;
y3 = 1 + a./(x3 - c).^b;
loglog(x3,y3)
title('|resi/Y_{rms}| vs |Yfit|')
%yline([1],'--k',LineWidth=1.5)
%ylim([1e-5, 10])
hold off

subplot(2,4,7)
loglog(abs(yy2),abs(residx2/sqrt(mean(yy2.^2))),'.b')
title('|resi/Y_{rms}| vs |Y|')
hold on
x3=log10([1e-4 1e2]); y3=-(1/2)*x3 + 0*1.4;
%loglog(10.^x3,10.^y3,'--k','LineWidth',2)
yline([1],'--k',LineWidth=1.5)
ylim([1e-5 10])
%xlim([0.06 52])
%txt = '$k_{\perp} \sim k_{\parallel}^{3/2}$';
%txt2 = '$k_{\perp} \sim k_{\parallel}$';
hold off
subplot(2,4,8)
loglog(abs(xx2),abs(residx2./sqrt(mean(yy2.^2))),'.b')
title('|resi/Y_{rms}| vs |x|')
yline([1],'--k',LineWidth=1.5)
ylim([1e-5 10])

saveas(f55,strcat(num2str(i),'normal_distri.png'));
saveas(f56,strcat(num2str(i),'uniform_distri.png'));
%}
