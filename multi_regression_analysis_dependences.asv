%CI_bootstrap_Xx_KHW_all = CIBoot_strap(X_KHW_all,Yx);
%CI_bootstrap_Xy_KHW_all = CIBoot_strap(X_KHW_all,Yy);
%CI_bootstrap_Xz_KHW_all = CIBoot_strap(X_KHW_all,Yz);


%stopp

% % 
% % CI95_Xx = Confidence_Intervals(Xx,Yx);
% % CI95_Xy = Confidence_Intervals(Xy,Yy);
% % CI95_Xz = Confidence_Intervals(Xz,Yz);
% % 
% % CI95_Xx_KHW = Confidence_Intervals(Xx_KHW,Yx);
