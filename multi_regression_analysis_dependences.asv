    'NumBins',50,'LineWidth',1,'LegendVisible','on',HistogramDisplayStyle="bar", ...
    LineStyle="-");
s.Color = {'k'};
xlabel('|Yfit|')
ylabel('|Residuals|')
title('|Residuals| vs |fitted| Div Pi');%ylim([0,10])

