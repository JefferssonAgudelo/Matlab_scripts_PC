% This is the section related to the statistical checking of the robustness
% of the models 
%--------------------------------------------------------------------------
%--------------------------------------------------------------------------

% Confidence Intervals
% Why: Confidence intervals tell you how precise your coefficient estimates are.
% If a CI includes 0 → the coefficient might not be significant.
% Narrow CI → robust, wide CI → less reliable.

%CI95_Xx = Confidence_Intervals(Xx, Yx);

% CI95 =
%    -0.0005   -0.0005
%     0.0186    0.0188
%     0.0075    0.0077
%     0.0082    0.0086


%VIF
% Why: To detect multicollinearity. High VIF means the coefficient estimate is unstable due to redundancy among predictors.
% VIF ≈ 1: No collinearity
% VIF > 5: Moderate collinearity
% VIF > 10: Severe multicollinearity → unstable coefficients

%vif_Xx = compute_vif(Xx);


% Bootstrap the regression <------- This option takes a lot of time because
% of the iteration processes. 
%Why: Evaluate how coefficient estimates vary with resampled data → gives empirical CIs and stability check.
% Narrow bootstrap CI → robust coefficient.
% Highly variable bootstrap distribution → unstable model.

%CI_bootstrap = CIBoot_strap(Xx,Yx);
%clearvars Xx Xx_KHW Xx_comp Xy Xy_KHW Xy_comp Xz Xz_KHW Xz_comp X_KHW_all

%CI_bootstrap_Xx = CIBoot_strap(Xx,Yx);
