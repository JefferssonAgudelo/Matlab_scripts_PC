residz = (Yz-Yfit)./Yz;
plot(Yfit,residz,'*c')
%xscale log
yscale log
xlabel('|Yfit|')
ylabel('|Residuals|')
title('Residuals_z vs fitted_z grad nz');%ylim([-0.1,0.1])


subplot(2,4,8)
Yfit = sqrt( (Yxfit').^2 + (Yyfit').^2 + (Yzfit').^2);
resid = sqrt(residx.^2 + residy.^2 + residz.^2)./sqrt(Yx.^2 + Yy.^2 + Yz.^2 );
plot(Yfit,resid,'*c')
xlabel('|Yfit|')
ylabel('|Residuals|')
title('|Residuals| vs |fitted| grad n');%ylim([0,10])
yscale log
%}
