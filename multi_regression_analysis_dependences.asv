% This is the part to check how it changes with the divergence of the
% pressure

%--------------------------------------------------------------------------
XxdivPi = [Div_Pi_x_scatter', Div_Pi_y_scatter', Div_Pi_z_scatter'];
P = polyfit(Div_Pi_x_scatter,Yx,1); Yxfit = P(1)*Div_Pi_x_scatter+P(2);
P = polyfit(Div_Pi_y_scatter,Yy,1); Yyfit = P(1)*Div_Pi_y_scatter+P(2);
P = polyfit(Div_Pi_z_scatter,Yz,1); Yzfit = P(1)*Div_Pi_z_scatter+P(2);

[resi_Xx1,coeffs_Xx1,Rs_Xx1, QR_Xx1] = multilinear_regression_var(XxdivPi,Yx);
[resi_Xx2,coeffs_Xx2,Rs_Xx2, QR_Xx2] = multilinear_regression_var(XxdivPi,Yy);
[resi_Xx3,coeffs_Xx3,Rs_Xx3, QR_Xx3] = multilinear_regression_var(XxdivPi,Yz);

