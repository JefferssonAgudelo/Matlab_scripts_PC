function[pearson_coeff] =Pearson_Coeff(X,Y)
%--------------------------------------------------------------------------
cova = mean((X-mean(X)).*(Y-mean(Y)));
stdX = sqrt(mean(X.^2) - mean(X).^2);
stdY = sqrt(mean(Y.^2) - mean(Y).^2);
pearson_coeff = cova/(stdX*stdY);
%--------------------------------------------------------------------------
end


function[residuals,coeffs,R_squared,diagonalR] = multilinear_regression_var(X,Y)
% X is a 3 vector array of predictors, Y is one vector array,  
%--------------------------------------------------------------------------
% Check rank
r = rank(X);
nVars = size(X, 2);  % Should be 3

% Output result
if r == nVars
    disp('✅ The variables X1 to X3 are linearly independent.');
else
    disp('❌ The variables X1 to X3 are linearly dependent.');
    fprintf('Rank is %d < %d (number of variables).\n', r, nVars);
end

% --- QR decomposition ---
[Q, R] = qr(X, 0);  % Economy-size QR

% --- Check for linear dependence using the diagonal of R ---
tol = 1e-12;  % Tolerance for numerical precision
diagonalR = abs(diag(R));

fprintf('QR diagonal values:\n');
disp(diagonalR);

% Determine which columns are linearly independent
independentCols = find(diagonalR > tol);
dependentCols   = find(diagonalR <= tol);

% --- Display result ---
if length(independentCols) == size(X, 2)
    disp('✅ All variables X1 to X3 are linearly independent.');
else
    disp('❌ Some variables are linearly dependent.');
    fprintf('Linearly independent variables: X%d\n', independentCols);
    fprintf('Linearly dependent variables: X%d\n', dependentCols);
end


% Step 1: Add intercept term (column of ones)
X_aug = [ones(size(X,1), 1), X];  % Now X_aug is n x 7
% Step 2: Compute regression coefficients (a0 to a6)
coeffs = (X_aug' * X_aug) \ (X_aug' * Y);  % 7 x 1 vector
% Step 3: Make predictions
Y_pred = X_aug * coeffs;
% Optional: Display results
disp('Intercept (a0) and coefficients (a1 to a3):');
disp(coeffs);

% Optional: Compute R²
residuals = Y - Y_pred;

SS_res = sum(residuals.^2);
SS_tot = sum((Y - mean(Y)).^2);

R_squared = 1 - SS_res / SS_tot;

fprintf('R-squared: %.4f\n', R_squared);

end
%--------------------------------------------------------------------------


%--------------------------------------------------------------------------
function vif_values = compute_vif(X)
% compute_vif - Computes Variance Inflation Factors for each column in X
% INPUT:
%   X: matrix of predictors (n_samples x n_predictors)
% OUTPUT:
%   vif_values: row vector of VIFs for each predictor

[n, p] = size(X);
vif_values = zeros(1, p);

for j = 1:p
    % Set X_j as the target
    y = X(:,j);
    
    % Set the other predictors as inputs
    X_others = X(:, setdiff(1:p, j));
    
    % Add intercept
    X_aug = [ones(n,1), X_others];
    
    % Compute coefficients
    beta = (X_aug' * X_aug) \ (X_aug' * y);
    
    % Predicted y and R²
    y_pred = X_aug * beta;
    SS_res = sum((y - y_pred).^2);
    SS_tot = sum((y - mean(y)).^2);
    R2_j = 1 - SS_res / SS_tot;
    
    % Compute VIF
    vif_values(j) = 1 / (1 - R2_j);
end
end
%--------------------------------------------------------------------------

% Compute Confidence Intervals (CI) for Coefficients. Confidence intervals tell you how precise your coefficient estimates are.
%--------------------------------------------------------------------------
function CI95 = Confidence_Intervals(Xx, Yx)
X_aug = [ones(size(Xx,1),1), Xx];  % Augmented matrix with intercept
n = size(X_aug,1);
p = size(X_aug,2);

% Fit coefficients
beta = (X_aug' * X_aug) \ (X_aug' * Yx);

% Residuals
residuals = Yx - X_aug * beta;
sigma2 = sum(residuals.^2) / (n - p);

% Covariance matrix
cov_beta = sigma2 * inv(X_aug' * X_aug);

% Standard errors and 95% CI
SE = sqrt(diag(cov_beta));
CI95 = [beta - 1.96*SE, beta + 1.96*SE];
end
%--------------------------------------------------------------------------

%compute the standard deviation of the bootstrapped coefficients to estimate uncertainty:
%--------------------------------------------------------------------------
function [CI95, SE] = Confidence_Intervals2(X, Y, nboot)
% Compute 95% confidence intervals and standard errors of regression coefficients
% using bootstrap resampling. Includes an intercept term.
%
% Inputs:
%   X      - Predictor matrix (n x p)
%   Y      - Response vector (n x 1)
%   nboot  - (Optional) Number of bootstrap samples (default: 1000)
%
% Outputs:
%   CI95   - 95% confidence intervals [lower, upper] for each coefficient (p+1 x 2)
%   SE     - Standard error for each coefficient (p+1 x 1)

    if nargin < 3
        nboot = 1000;
    end

    [n, p] = size(X);
    X_aug = [ones(n, 1), X];  % Include intercept
    coefs_boot = zeros(nboot, p + 1);  % (intercept + p predictors)

    % Bootstrap loop
    for i = 1:nboot
        idx = randi(n, n, 1);  % Sample with replacement
        Xb = X_aug(idx, :);
        Yb = Y(idx);
        % Solve least-squares: β = (XᵗX)⁻¹ XᵗY
        coefs_boot(i, :) = (Xb' * Xb) \ (Xb' * Yb);
    end

    % Compute 95% confidence intervals (2.5 and 97.5 percentiles)
    CI95 = prctile(coefs_boot, [2.5, 97.5])';  % Transpose to get (p+1) x 2

    % Standard error = std deviation across bootstrap samples
    SE = std(coefs_boot, 0, 1)';  % Column vector (p+1 x 1)
end

%--------------------------------------------------------------------------


%--------------------------------------------------------------------------
function CI_bootstrap = CIBoot_strap(Xx,Yx)
nBoot = 1000;
n = length(Yx);
boot_coeffs = zeros(nBoot, size(Xx,2)+1);

for i = 1:nBoot
    idx = randi(n, n, 1);
    Xb = Xx(idx,:);
    Yb = Yx(idx);
    Xb_aug = [ones(size(Xb,1),1), Xb];
    boot_coeffs(i,:) = (Xb_aug' * Xb_aug) \ (Xb_aug' * Yb);
end

CI_bootstrap = prctile(boot_coeffs, [2.5 97.5]);
end
%--------------------------------------------------------------------------

%
%--------------------------------------------------------------------------
function [Xz, mu, sigma] = zscore_columns(X)
    mu = mean(X, 1);
    sigma = std(X, 0, 1);
    Xz = (X - mu) ./ sigma;
end

