semilogy(abs(QR_KHW_all_x),'ok')
title('QRs')
legend('JBO','KJHBWO','Jton','KJHBWO_{xyz}')
hold off

subplot(3,4,10)
semilogy(Rs_x,'*r')
hold on
semilogy(Rs_KHW_x,'*b')
