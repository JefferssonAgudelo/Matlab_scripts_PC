%--------------------------------------------------------------------------




%--------------------------------------------------------------------------
%
% Y = var_tau_total_x';

% X = [J_scatter_x', B_scatter_x',vort_scatter_x'];
% X_KHW = [KJ_scatter_x', HB_scatter_x',Wvort_scatter_x'];
% X_comp = [J_scatter_x', B_scatter_x',vort_scatter_x',v_scatter_x',E_scatter_x', n_scatter'];
% X_KHW_all = [KJ_scatter_x', HB_scatter_x',Wvort_scatter_x',...
%              KJ_scatter_y', HB_scatter_y',Wvort_scatter_y',...
%              KJ_scatter_z', HB_scatter_z',Wvort_scatter_z'];
% 
% [resi_x,coeffs_x,Rs_x, QR_x] = multilinear_regression_var(X,Y);
% [resi_KHW_x,coeffs_KHW_x,Rs_KHW_x,QR_KHW_x] = multilinear_regression_var(X_KHW,Y);
% [resi_comp_x,coeffs_comp_x, Rs_comp_x, QR_comp_x] = multilinear_regression_var(X_comp,Y);
% [resi_KHW_all_x,coeffs_KHW_all_x, Rs_KHW_all_x, QR_KHW_all_x] = multilinear_regression_var(X_KHW_all,Y);
% 
% clearvars X X_KHW X_comp X_KHW_all

%--------------------------------------------------------------------------


%
%--------------------------------------------------------------------------
Xx = [J_scatter_x', B_scatter_x',vort_scatter_x'];
Xy = [J_scatter_y', B_scatter_y',vort_scatter_y'];
Xz = [J_scatter_z', B_scatter_z',vort_scatter_z'];

Xx_KHW = [KJ_scatter_x', HB_scatter_x',Wvort_scatter_x'];
Xy_KHW = [KJ_scatter_y', HB_scatter_y',Wvort_scatter_y'];
Xz_KHW = [KJ_scatter_z', HB_scatter_z',Wvort_scatter_z'];

Xx_comp = [J_scatter_x', B_scatter_x',vort_scatter_x',v_scatter_x',E_scatter_x', n_scatter'];
Xy_comp = [J_scatter_y', B_scatter_y',vort_scatter_y',v_scatter_y',E_scatter_y', n_scatter'];
Xz_comp = [J_scatter_z', B_scatter_z',vort_scatter_z',v_scatter_z',E_scatter_z', n_scatter'];

X_KHW_all = [KJ_scatter_x', HB_scatter_x',Wvort_scatter_x',...
             KJ_scatter_y', HB_scatter_y',Wvort_scatter_y',...
             KJ_scatter_z', HB_scatter_z',Wvort_scatter_z'];

%Model 5 
Xx_mod5 = [v_scatter_x',E_scatter_x', n_scatter'];
Xy_mod5 = [v_scatter_y',E_scatter_y', n_scatter'];
Xz_mod5 = [v_scatter_z',E_scatter_z', n_scatter'];
%--------------------------------------------------------------------------


% this is to remove the mean of each predictor and to ensure they all are
% non-dimensional
%--------------------------------------------------------------------------
[Xx, ~] = zscore_columns(Xx);
[Xy, ~] = zscore_columns(Xy);
[Xz, ~] = zscore_columns(Xz);

[Xx_KHW, ~] = zscore_columns(Xx_KHW);
[Xy_KHW, ~] = zscore_columns(Xy_KHW);
[Xz_KHW, ~] = zscore_columns(Xz_KHW);

[Xx_comp, ~] = zscore_columns(Xx_comp);
[Xy_comp, ~] = zscore_columns(Xy_comp);
[Xz_comp, ~] = zscore_columns(Xz_comp);

[X_KHW_all, ~] = zscore_columns(X_KHW_all);

[Xx_mod5, ~] = zscore_columns(Xx_mod5);
[Xy_mod5, ~] = zscore_columns(Xy_mod5);
[Xz_mod5, ~] = zscore_columns(Xz_mod5);
%--------------------------------------------------------------------------


%--------------------------------------------------------------------------
[resi_Xx,coeffs_Xx,Rs_Xx, QR_Xx] = multilinear_regression_var(Xx,Yx);
[resi_Xy,coeffs_Xy,Rs_Xy, QR_Xy] = multilinear_regression_var(Xy,Yy);
[resi_Xz,coeffs_Xz,Rs_Xz, QR_Xz] = multilinear_regression_var(Xz,Yz);

[resi_KHW_Xx,coeffs_KHW_Xx,Rs_KHW_Xx,QR_KHW_Xx] = multilinear_regression_var(Xx_KHW,Yx);
[resi_KHW_Xy,coeffs_KHW_Xy,Rs_KHW_Xy,QR_KHW_Xy] = multilinear_regression_var(Xy_KHW,Yy);
[resi_KHW_Xz,coeffs_KHW_Xz,Rs_KHW_Xz,QR_KHW_Xz] = multilinear_regression_var(Xz_KHW,Yz);

[resi_comp_Xx,coeffs_comp_Xx,Rs_comp_Xx,QR_comp_Xx] = multilinear_regression_var(Xx_comp,Yx);
[resi_comp_Xy,coeffs_comp_Xy,Rs_comp_Xy,QR_comp_Xy] = multilinear_regression_var(Xy_comp,Yy);
[resi_comp_Xz,coeffs_comp_Xz,Rs_comp_Xz,QR_comp_Xz] = multilinear_regression_var(Xz_comp,Yz);

[resi_KHW_all_Xx,coeffs_KHW_all_Xx, Rs_KHW_all_Xx, QR_KHW_all_Xx] = multilinear_regression_var(X_KHW_all,Yx);
[resi_KHW_all_Xy,coeffs_KHW_all_Xy, Rs_KHW_all_Xy, QR_KHW_all_Xy] = multilinear_regression_var(X_KHW_all,Yy);
[resi_KHW_all_Xz,coeffs_KHW_all_Xz, Rs_KHW_all_Xz, QR_KHW_all_Xz] = multilinear_regression_var(X_KHW_all,Yz);

[resi_mod5_Xx,coeffs_mod5_Xx, Rs_mod5_Xx, QR_mod5_Xx] = multilinear_regression_var(Xx_mod5,Yx);
[resi_mod5_Xy,coeffs_mod5_Xy, Rs_mod5_Xy, QR_mod5_Xy] = multilinear_regression_var(Xy_mod5,Yy);
[resi_mod5_Xz,coeffs_mod5_Xz, Rs_mod5_Xz, QR_mod5_Xz] = multilinear_regression_var(Xz_mod5,Yz);
%--------------------------------------------------------------------------


%stopp




% find the J for a given value of B
%--------------------------------------------------------------------------
% This is to find the poinst that have a given vale of B and O to find teh
% conditional slope (The slope is changing depending on the sampled values)
%--------------------------------------------------------------------------
% Define the interval of B
%--------------------------------------------------------------------------
%--------------------------------------------------------------------------
%{
Bx_abs_mean = mean(abs(B_scatter_x));
Bx_std = std(abs(B_scatter_x));

vortx_abs_mean = mean(abs(vort_scatter_x));
vortx_std = std(abs(vort_scatter_x));
vortx_max = max(vort_scatter_x);
vortx_min = min(vort_scatter_x);

cond1 = 1*Bx_abs_mean - 0.1*Bx_std ; 
cond2 = 1*Bx_abs_mean + 0.1*Bx_std;

cond3 = 1*vortx_abs_mean - 0.1*vortx_std; 
cond4 = 1*vortx_abs_mean + 0.1*vortx_std;

J_scatter_x_con = J_scatter_x((B_scatter_x > cond1) & (B_scatter_x < cond2) );
Yx_con = Yx((B_scatter_x > cond1) & (B_scatter_x < cond2) );

J_scatter_x_con2 = J_scatter_x((B_scatter_x > cond1) & (B_scatter_x < cond2) & (vort_scatter_x > cond3) & (vort_scatter_x < cond4));
Yx_con2 = Yx((B_scatter_x > cond1) & (B_scatter_x < cond2) & (vort_scatter_x > cond3) & (vort_scatter_x < cond4));

P = polyfit(J_scatter_x_con2,Yx_con2,1); 

Yxfit = P(1)*J_scatter_x_con2 + P(2);

% get the fit from the multilinear 


f23=figure(23);
subplot(1,3,1)
scatter(J_scatter_x, Yx,'.r')
title('all')
subplot(1,3,2)
scatter(J_scatter_x_con, Yx_con,'.b')
title('J cond B')
subplot(1,3,3)
scatter(J_scatter_x_con2, Yx_con2,'.k')
hold on
plot(J_scatter_x_con2,Yxfit,'r-',LineWidth=2)
xbasi = linspace(min(J_scatter_x), max(J_scatter_x),100);
ybasi = coeffs_Xx(1,1) + xbasi*coeffs_Xx(2,1) + Bx_abs_mean.*coeffs_Xx(3,1) + vortx_abs_mean.*coeffs_Xx(4,1); 
plot(xbasi, ybasi,'b-',LineWidth=2)
title('J cond B and O')
legend('YvsJ','linear fit','multi-linear fit')
hold off

Yx = var_tau_total_x';
NN=16;
Bx_max = max(B_scatter_x);
Bx_min = min(B_scatter_x);
Ox_max = max(vort_scatter_x);
Ox_min = min(vort_scatter_x);

Pn = zeros(NN,1);
DBmax_min = Bx_max - Bx_min;
dB = DBmax_min/NN;
B1 = Bx_min + dB;

DOmax_min = vortx_max - vortx_min;
dO = DOmax_min/NN;
O1 = Ox_min + dO;

i=1;
B2=B1; O2=O1;
Yx=Yx';

CM = cool(NN);

f22=figure(22);
while((B2<Bx_max) && (O2<Ox_max))
    B2 = B1 + 1*dB;
    O2 = O1 + 1*dO;
    J_scatter_x_con2 = J_scatter_x((B_scatter_x > B1) & (B_scatter_x < B2) & (vort_scatter_x > O1) & (vort_scatter_x < O2));
    Yx_con2 = Yx((B_scatter_x > B1) & (B_scatter_x < B2) & (vort_scatter_x > O1) & (vort_scatter_x < O2));
    B1 = B2;
    O1 = O2;

    Ptmp = polyfit(J_scatter_x_con2,Yx_con2,1);
    Pn(i,1)= Ptmp(1);
    i=i+1;

    Yxfit = Ptmp(1)*J_scatter_x_con2 + Ptmp(2);
    plot(J_scatter_x_con2,Yxfit,'color',CM(i,:),LineWidth=2)
    title('J cond B and O')
    %scatter(J_scatter_x_con2, Yx_con2,'.k')
    hold on
    %colorbar
end
    plot(xbasi, ybasi,'b-',LineWidth=2)
hold off


f21=figure(21);
histogram(Pn,NN/2)
title('slopes')
%}
%--------------------------------------------------------------------------



% Now let's make the other plots including the condition thing Y vs J including the fit for a single value of B and Omega    

% This doesn't look to promising 
%--------------------------------------------------------------------------
%{
Bx_abs_mean = mean(abs(B_scatter_x));
Bx_std = std(abs(B_scatter_x));
vortx_abs_mean = mean(abs(vort_scatter_x));
vortx_std = std(abs(vort_scatter_x));

cond1 = 1*Bx_abs_mean - 0.1*Bx_std ; 
cond2 = 1*Bx_abs_mean + 0.1*Bx_std;
cond3 = 1*vortx_abs_mean - 0.1*vortx_std; 
cond4 = 1*vortx_abs_mean + 0.1*vortx_std;

xbasi2B = B_scatter_x.*((B_scatter_x > cond1) & (B_scatter_x < cond2));
xbasi2O = vort_scatter_x.*((vort_scatter_x > cond3) & (vort_scatter_x < cond4));

xbasi2B=xbasi2B';
xbasi2O=xbasi2O';

f44=figure(44)

subplot(1,3,1)
plot(Xx(:,1), Yx,'r.')
title('YvsJ')
subplot(1,3,2)
xbasi = coeffs_Xx(1,1) + Xx(:,1)*coeffs_Xx(2,1) + 0.1.*coeffs_Xx(3,1) + 0.1.*coeffs_Xx(4,1); 
plot(xbasi, Yx,'.')
title('Y vs a0 + a1J + C(a2Bo,a3Oo)')
subplot(1,3,3)
xbasi2 = coeffs_Xx(1,1) + Xx(:,1)*coeffs_Xx(2,1) + xbasi2B(:,1)*coeffs_Xx(3,1) + xbasi2O(:,1)*coeffs_Xx(4,1); 
plot(Xx(:,1), Yx,'k.')
title('Y vs a0 + a1J + a2Bo + a3Oo')

