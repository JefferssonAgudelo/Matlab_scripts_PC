% % % Yfit = sqrt( (Yx-resi_KHW_all_Xx).^2 + (Yy-resi_KHW_all_Xy).^2 + (Yz-resi_KHW_all_Xz).^2);
% % % resid = sqrt(resi_KHW_all_Xx.^2 + resi_KHW_all_Xy.^2 + resi_KHW_all_Xz.^2);
% % % %resid = sqrt((resi_KHW_all_Xx.*100./Yx).^2 + (resi_KHW_all_Xy.*100./Yx).^2 + (resi_KHW_all_Xz.*100./Yx).^2);
% % % %resid = sqrt((resi_KHW_all_Xx.*100./Yfit).^2 + (resi_KHW_all_Xy.*100./Yfit).^2 + (resi_KHW_all_Xz.*100./Yfit).^2);
% % % % tbl = table(Yfit,resid);
% % % % s = scatterhistogram(tbl,'Yfit','resid', ...
% % % %     'NumBins',50,'LineWidth',1,'LegendVisible','on',HistogramDisplayStyle="bar", ...
