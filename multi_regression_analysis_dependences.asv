vif_Xx = compute_vif(Xx);
vif_Xy = compute_vif(Xy);
vif_Xz = compute_vif(Xz);

vif_KHW_Xx = compute_vif(Xx_KHW);
vif_KHW_Xy = compute_vif(Xy_KHW);
vif_KHW_Xz = compute_vif(Xz_KHW);

vif_comp_Xx = compute_vif(Xx_comp);
vif_comp_Xy = compute_vif(Xy_comp);
vif_comp_Xz = compute_vif(Xz_comp);

vif_KHW_all_Xx = compute_vif(X_KHW_all); %????
vif_KHW_all_Xy = vif_KHW_all_Xx;
vif_KHW_all_Xz = vif_KHW_all_Xx;

vif_mod5_Xx = compute_vif(Xx_mod5);
vif_mod5_Xy = compute_vif(Xy_mod5);
vif_mod5_Xz = compute_vif(Xz_mod5);




% This is to make the table including all the information about the fits
%--------------------------------------------------------------------------
% --- Model names for table indexing
% --- Define model names for looping
model_names = {'Xx','Xy','Xz',...
               'KHW_Xx','KHW_Xy','KHW_Xz',...
               'comp_Xx','comp_Xy','comp_Xz',...
               'KHW_all_Xx','KHW_all_Xy','KHW_all_Xz',...
               'mod5_Xx','mod5_Xy','mod5_Xz'};

% --- Initialize containers
coeff_struct = struct();
Rs_struct = struct();
diagR_struct = struct();
SE_struct = struct();
Pearson_coef_struct = struct();


% --- Load values into structs dynamically
for i = 1:length(model_names)
    model = model_names{i};
    coeff_struct.(model) = eval(['coeffs_' model]);
    SE_struct.(model) = eval(['SE_' model]);
    Rs_struct.(model) = eval(['Rs_' model]);
    diagR_struct.(model) = eval(['QR_' model]);  % This is diagonalR
end

% --- Determine max lengths for padding
max_coeff_len = max(structfun(@(v) numel(v), coeff_struct));
max_SE_len = max(structfun(@(v) numel(v), SE_struct));
max_diagR_len = max(structfun(@(v) numel(v), diagR_struct));

% --- Build Coefficients Table
coeff_table = table((1:max_coeff_len)', 'VariableNames', {'Coeff_Index'});
for i = 1:length(model_names)
    model = model_names{i};
    vals = coeff_struct.(model);
    padded = nan(max_coeff_len, 1);
    padded(1:numel(vals)) = vals(:);
    coeff_table.(model) = padded;
end

% --- Build SE Table
SE_table = table((1:max_SE_len)', 'VariableNames', {'Coeff_Index'});
for i = 1:length(model_names)
    model = model_names{i};
    vals = SE_struct.(model);
    padded = nan(max_SE_len, 1);
    padded(1:numel(vals)) = vals(:);
    SE_table.(model) = padded;
end

% --- Build R² Table (single-row table)
Rs_table = array2table(zeros(1, numel(model_names)), 'VariableNames', model_names);
for i = 1:length(model_names)
    model = model_names{i};
    Rs_table{1, model} = Rs_struct.(model);
end

% --- Build Diagonal R Table
diagR_table = table((1:max_diagR_len)', 'VariableNames', {'Diag_Index'});
for i = 1:length(model_names)
    model = model_names{i};
    vals = diagR_struct.(model);
    padded = nan(max_diagR_len, 1);
    padded(1:numel(vals)) = vals(:);
    diagR_table.(model) = padded;
end

% --- Display tables
disp('--- Coefficients Table ---');
disp(coeff_table);

disp('--- SE Table ---');
disp(SE_table);

disp('--- R² Table ---');
disp(Rs_table);

disp('--- Diagonal of R Matrix Table ---');
disp(diagR_table);

% --- Optionally export to CSV
writetable(coeff_table, 'regression_coefficients_beta4_norm.csv');
writetable(Rs_table, 'regression_R2_beta4_norm.csv');
writetable(diagR_table, 'regression_diagR_beta4_norm.csv');
writetable(SE_table, 'regression_SE_beta4_norm.csv');
% --- Optionally export to CSV
writetable(Pearson_coeff_table, 'Pearson_coefficients_beta4_norm.csv');
%--------------------------------------------------------------------------




% This is to make the table for the statistical things
%--------------------------------------------------------------------------
% --- Define model names (used in your variables)
model_tags = {'Xx','Xy','Xz',...
               'KHW_Xx','KHW_Xy','KHW_Xz',...
               'comp_Xx','comp_Xy','comp_Xz',...
               'KHW_all_Xx','KHW_all_Xy','KHW_all_Xz',...
               'mod5_Xx','mod5_Xy','mod5_Xz'};


% --- Initialize CI and VIF containers
ci_struct = struct();
vif_struct = struct();
%SE_struct = struct();

% --- Load data dynamically
for i = 1:length(model_tags)
    tag = model_tags{i};
    ci_struct.(tag) = eval(['CI95_' tag]);
    vif_struct.(tag) = eval(['vif_' tag]);
    %SE_struct.(tag) = eval(['SE_' tag]);    
end

% --- Find maximum number of coefficients (pad shorter vectors with NaN)
max_n_coeff = max(structfun(@(x) size(x,1), ci_struct));
max_n_vif   = max(structfun(@numel, vif_struct));


% === Build Confidence Interval Summary Table ===
ci_table = table((1:max_n_coeff)', 'VariableNames', {'Coeff_Index'});
for i = 1:length(model_tags)
    tag = model_tags{i};
    ci = ci_struct.(tag);  % size: n_coeff x 2

    % Pad with NaNs if needed
    pad_ci = nan(max_n_coeff, 2);
    pad_ci(1:size(ci,1), :) = ci;

    % Add as separate columns for each model
    ci_table.([tag '_Low'])  = pad_ci(:,1);
    ci_table.([tag '_High']) = pad_ci(:,2);
end

% === Build VIF Summary Table ===
vif_table = table((1:max_n_vif)', 'VariableNames', {'Variable_Index'});
for i = 1:length(model_tags)
    tag = model_tags{i};
    vif = vif_struct.(tag);
    
    % Pad with NaNs if needed
    pad_vif = nan(max_n_vif,1);
    pad_vif(1:numel(vif)) = vif(:);
    
    vif_table.(tag) = pad_vif;
end

% === Display the tables ===
disp('--- Confidence Intervals Table ---');
disp(ci_table);

disp('--- VIF Table ---');
disp(vif_table);

% === Optionally export to CSV ===
writetable(ci_table, 'confidence_intervals_summary_beta4_norm.csv');
writetable(vif_table, 'vif_summary_beta4_norm.csv');
