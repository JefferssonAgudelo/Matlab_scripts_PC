Yfit = sqrt( (YGnxfit').^2 + (YGnyfit').^2 + (YGnzfit').^2);
resid = sqrt(residx.^2 + residy.^2 + residz.^2)./sqrt(Yx.^2 + Yy.^2 + Yz.^2 );
plot(Yfit,resid,'*c')
xlabel('|Yfit|')
ylabel('|Residuals|')
title('|Residuals| vs |fitted| grad n');%ylim([0,10])
yscale log


subplot(2,4,5)
Yfit = Yxfit';
residx = (Yx-Yfit)./Yx;
plot(Yfit,residx,'*r')
%xscale log
yscale log
xlabel('|Yfit|')
ylabel('|Residuals|')
title('Residuals_x vs fitted_x grad nx');%ylim([-0.1,0.1])

subplot(2,4,6)
clearvars residy Yfit
Yfit = Yyfit';
residy = (Yy-Yfit)./Yy;
plot(Yfit,residy,'*b')
%xscale log
yscale log
xlabel('|Yfit|')
ylabel('|Residuals|')
title('Residuals_y vs fitted_y grad ny');%ylim([-0.1,0.1])

subplot(2,4,7)
