    end
    %-----------------------------------------------------------------------------------------------------------------------

    % For the scripts
    path_comp = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/Data_comparison';
    path_s  = '/Users/jeffersson_agudelo/Documents/CB104_local_data/Matlab_Scripts_here/Scripts_spectra';
    path_s2 = '/Users/jeffersson_agudelo/Documents/CB104_local_data/Matlab_Scripts_here';
    %-----------------------------------------------------------------------------------------------------------------------

    %-----------------------------------------------------------------------------------------------------------------------
    % To save the plots
    path_rec_r = strcat(path,'/spectra/rec_r');
    path_rec_line = strcat(path,'/spectra/rec_line');
    path_rec_line_ByBzJx = strcat(path,'/spectra/rec_line/ByBzJx');

    if not(isfolder(path_rec_r))
        mkdir(path_rec_r)
    end
    if not(isfolder(path_rec_line))
        mkdir(path_rec_line)
    end
    if not(isfolder(path_rec_line_ByBzJx))
        mkdir(path_rec_line_ByBzJx)
    end
    %-----------------------------------------------------------------------------------------------------------------------

    cd(path)
    %--------------------------------------------------------------------------
    S = dir(fullfile(path,'pfd.*.h5'));
    N=numel(S); % number of files to use
    H=zeros(N);
    %--------------------------------------------------------------------------
    S2 = dir(fullfile(path,'pfd_moments.*.h5'));
    N2=numel(S2); % number of files to use
    H2=zeros(N2);
    %--------------------------------------------------------------------------

    %--------------------------------------------------------------------------
    %B are normalized to the background magnetic field
    B0=0.2;
    %n is normalise to the proton density n0=1
    n0=1;
    %Vi normalised to the proton alfven speed V_a=0.1c The alfven speed of
    %electrons is Vae=10Vai
    Vae=0.2;%0.2;
    Va=0.2;%0.2;
    %--------------------------------------------------------------------------
    nb_n0 =0.1;
    kb = 1.; mu0 =1.; c=1; q = 1;

    Vai=0.2;
    Vai_b=Vai/sqrt(nb_n0);
    Vae_b=Vae/sqrt(nb_n0);

    mime =1.;
    mi = 1.;
    me = 1. / mime; eps0=1.;
    omega_pi=1;
    Omega_e=Vai*sqrt(mime)*omega_pi;
    Omega_i=Omega_e / mime;
    TOmega_e=1/Omega_e;
    TOmega_i=1/Omega_i;
    omega_pe_Omega_ce=5;
    %--------------------------------------------------------------------------
    in=1;
    fileID =  S(in).name; %change the 1 per i
    %h5disp(fileID);
    info = h5info(fileID);
    EHJ_1st = info.Groups(16).Name;
    B=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'));
    ss=size(B);
    LZs=ss(3);
    clearvars B
    N_jn=N;

    % %--------------------------------------------------------------------
    % % Making a plot for B2 as a function of time to see the growth rate of
    % the instability
    % %--------------------------------------------------------------------

    in=1;
    fileID =  S(in).name; %change the 1 per i
    %h5disp(fileID);
    info = h5info(fileID);
    EHJ_1st = info.Groups(16).Name;
    B=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'));
    ss=size(B);
    LXs=ss(1); LYs=ss(2); LZs=ss(3);
    %--------------------------------------------------------------------------
    nx1=1;    nx2=LXs;
    ny1=1;    ny2=LYs;
    nz1=1;    nz2=LZs;

    px2 = nx2; py2 = ny2; pz2 = nz2;
    start = [nx1 ny1 nz1];
    count = [px2 py2 pz2];

    time_t_2=zeros(1,N);


    cd(path)
    in = 2;
    %in = N;
    %------------------------------------------------------------------
    disp(strcat('Computing step ...',S(in).name))
    fileID =  S(in).name; %change the 1 per i
    %h5disp(fileID);
    info = h5info(fileID);
    EHJ_1st = info.Groups(16).Name;
    grid_dt = info.Groups(20).Attributes;

    dt=double(grid_dt(15).Value);

    grid_ng = info.Groups(19).Attributes;
    dx=grid_ng(10).Value(1);
    dy=grid_ng(10).Value(2);
    dz=grid_ng(10).Value(3);

    grid_length = info.Groups(17).Attributes;
    Lx=grid_length(4).Value(1) - grid_length(3).Value(1);
    Ly=grid_length(4).Value(2) - grid_length(3).Value(2);
    Lz=grid_length(4).Value(3) - grid_length(3).Value(3);

    resx=double(Lx)/double(dx);
    resy=double(Ly)/double(dy);
    resz=double(Lz)/double(dz); res=resz;

    threshold=pi/resy;
    %------------------------------------------------------------------

    %------------------------------------------------------------------
    Bx=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'),start,count);
    By=h5read(fileID,strcat(EHJ_1st,'/hy_fc/p0/3d'),start,count);
    Bz=h5read(fileID,strcat(EHJ_1st,'/hz_fc/p0/3d'),start,count);

    Bx = Bx(1,:,:);
    By = By(1,:,:);
    Bz = Bz(1,:,:);

    % This is to apply the hammin window so the boundaries are periodic. 
    hammin_p =  hamming(ss(2),"periodic");
    Bx_perio = zeros(1,ss(2),ss(3));
    By_perio = Bx_perio; Bz_perio = Bx_perio;

    for i=1:ss(3)
        Bx_perio(1,:,i) = Bx(1,:,i).* hammin_p';
        By_perio(1,:,i) = By(1,:,i).* hammin_p';
        Bz_perio(1,:,i) = Bz(1,:,i).* hammin_p';

    end

    % %------------------------------------------------------------------
    % f12=figure(12)
    % subplot(2,3,1)
    % imagesc(squeeze(Bx))
    % colorbar
    % subplot(2,3,2)
    % imagesc(squeeze(Bx_perio))
    % colorbar
    % 
    %  subplot(2,3,3)
    % imagesc(squeeze(By))
    % colorbar
