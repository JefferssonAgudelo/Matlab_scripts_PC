    % imagesc(squeeze(By_perio))
    % colorbar
    % 
    % subplot(2,3,5)
    % imagesc(squeeze(Bz))
    % colorbar
    % subplot(2,3,6)
    % imagesc(squeeze(Bz_perio))
    % colorbar
    % %------------------------------------------------------------------

    %------------------------------------------------------------------
    dt=double(grid_dt(15).Value);
    str = string(S(in).name);
    newStr = extractBetween(str,"pfd.","_p000000.h5");
    N_steps = str2double(newStr);
    time_t = dt*N_steps;
    time_t_2_Omega=time_t./omega_pe_Omega_ce;
    time_t_2(1,in)=time_t_2_Omega;
    %------------------------------------------------------------------

    cd(path_s)
    spectraB=CalcSpectra_CB_local(Bx_perio,By_perio,Bz_perio,resx,resy,resz,threshold);

    fs=30; x0=45;y0=54;xx1=1200;yy1=500;
    % %----------------------------------------------------------------------
    % % Making plots
    % %----------------------------------------------------------------------
    %----------------------------------------------------------------------
    %P1D_perB=(spectraB.P1Dper);
    P1D_perB = (spectraB.P1Dper./max(spectraB.P1Dper));
    %P1D_parB = (spectraB.P1Dpar./max(spectraB.P1Dpar));

    f2=figure(2);
    set(gcf,'position',[x0,y0,xx1,yy1])
    
    loglog(2*spectraB.kper, (2*spectraB.kper).^(1) .* P1D_perB,'-','LineWidth',2)
    %loglog(spectraB.kpar, (spectraB.kpar).^(0) .* P1D_parB,'-','LineWidth',2)
    
    hold on
    set(gca,'FontSize',fs)
    %set(gca,'XScale','lin','YScale','log','FontSize',fs)
    x2=log10([0.1 40]);     y2=x2.*(-8/3)-4; 
    %loglog(10.^x2,10.^y2,'--b','LineWidth',2)
    txt5 = '$$ k_{\perp}^{-5/3}$$';
    %text(4 , 10e-3,txt5,'Interpreter','latex','FontSize',fs); 
    %xlim([0.1 threshold]);
    %ylim([10^(-6) 10^(0)]);
    %hold off
    %ylim([10^(3) 10^(13)]);
    y1=get(gca,'ylim');
    %----------------------------------------------------------------------
    frac = floor(N/6);
    Index_N = [2*frac, 3*frac, 4*frac, 5*frac, 6*frac];
    %Index_N = [floor(N/16), floor(N/8), floor(N/4), floor(N/2), floor(N/1)];
    jn=5
    for jn=1:5
        in=Index_N(jn);

        cd(path)

        %------------------------------------------------------------------
        disp(strcat('Computing step ...',S(in).name))
        fileID =  S(in).name; %change the 1 per i
        %h5disp(fileID);
        info = h5info(fileID);
        EHJ_1st = info.Groups(16).Name;
        grid_dt = info.Groups(20).Attributes;

        dt=double(grid_dt(15).Value);

        grid_ng = info.Groups(19).Attributes;
        dx=grid_ng(10).Value(1);
        dy=grid_ng(10).Value(2);
        dz=grid_ng(10).Value(3);

        grid_length = info.Groups(17).Attributes;
        Lx=grid_length(4).Value(1) - grid_length(3).Value(1);
        Ly=grid_length(4).Value(2) - grid_length(3).Value(2);
        Lz=grid_length(4).Value(3) - grid_length(3).Value(3);

        resx=double(Lx)/double(dx);
        resy=double(Ly)/double(dy);
        resz=double(Lz)/double(dz); res=resz;

        threshold=pi/resy;
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        Bx=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'),start,count);
        By=h5read(fileID,strcat(EHJ_1st,'/hy_fc/p0/3d'),start,count);
        Bz=h5read(fileID,strcat(EHJ_1st,'/hz_fc/p0/3d'),start,count);
        %------------------------------------------------------------------
        Bx = Bx(1,:,:);
        By = By(1,:,:);
        Bz = Bz(1,:,:);

        % This is to apply the hammin window so the boundaries are periodic.
        hammin_p =  hamming(ss(2),"periodic");
        Bx_perio = zeros(1,ss(2),ss(3));
        By_perio = Bx_perio; Bz_perio = Bx_perio;

        for i=1:ss(3)
            Bx_perio(1,:,i) = Bx(1,:,i).* hammin_p';
            By_perio(1,:,i) = By(1,:,i).* hammin_p';
            Bz_perio(1,:,i) = Bz(1,:,i).* hammin_p';
        end

        %------------------------------------------------------------------
        dt=double(grid_dt(15).Value);
        str = string(S(in).name);
        newStr = extractBetween(str,"pfd.","_p000000.h5");
        N_steps = str2double(newStr);
        time_t = dt*N_steps;
        time_t_2_Omega=time_t./omega_pe_Omega_ce;
        time_t_2(1,in)=time_t_2_Omega;
        %------------------------------------------------------------------
        cd(path_s)

        spectraB=CalcSpectra_CB_local(Bx_perio,By_perio,Bz_perio,resx,resy,resz,threshold);

        % %----------------------------------------------------------------------
        % % Making plots
        % %----------------------------------------------------------------------

        %----------------------------------------------------------------------
        %P1D_perB=(spectraB.P1Dper);
        P1D_perB=(spectraB.P1Dper./max(spectraB.P1Dper));
        loglog(2*spectraB.kper, (2*spectraB.kper).^(1) .* P1D_perB,'-','LineWidth',2)

        %P1D_parB=(spectraB.P1Dpar./max(spectraB.P1Dpar));
        %loglog(spectraB.kpar, (spectraB.kpar).^(0) .* P1D_parB,'-','LineWidth',2)

        cd(path)

    end
    %colororder('dye')
    legend('$t = \ $'+string(round((time_t_2(floor(2))),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        '$t = \ $'+string(round((time_t_2(2*frac)),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        '$t = \ $'+string(round((time_t_2(3*frac)),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        '$t = \ $'+string(round((time_t_2(4*frac)),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        '$t = \ $'+string(round((time_t_2(5*frac)),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        '$t = \ $'+string(round((time_t_2(6*frac)),2)) + '$$ \ \Omega_{e}^{-1}$$',...
        'Interpreter','latex')
    ax = gca; ax.TickLabelInterpreter = 'latex';ax.XLabel.Interpreter='latex';ax.YLabel.Interpreter='latex';
    ax.FontSize=fs; %ax.XTick = []; ax.YTick = [];
    ax.XLabel.String = '$k_\perp d_i$'; %'$k_\parallel d_i$';%;
    ax.YLabel.String = '$P^{B}_{1D_\perp}(k_{\perp}d_{i})^{8/3}$'; %'$P^{B}_{1D_\parallel}$';%
    hold off

    % cd(path_comp )
    % saveas(f2,strcat(num2str(kn),'_1D_spectrum_B_times_per_comp.png'));
    cd(path)
end








