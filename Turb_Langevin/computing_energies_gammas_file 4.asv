%--------------------------------------------------------------------------
% computing Energies from the gammas files 
%--------------------------------------------------------------------------
N_kn=14;
%--------------------------------------------------------------------------
B2_n_T = cell(1,N_kn);
E2_n_T = cell(1,N_kn);
U_EM2_n_T = cell(1,N_kn);
U_k_e_n_T = cell(1,N_kn);
U_k_i_n_T = cell(1,N_kn);
U_th_e_n_T = cell(1,N_kn);
U_th_i_n_T = cell(1,N_kn);

gammas = cell(1,N_kn);
%--------------------------------------------------------------------------
time_t_2_T = cell(1,N_kn);
%--------------------------------------------------------------------------
kn=1
for kn=1:N_kn

    % This set shows the difference in terms of the onset.
    % ABCDE
    %----------------------------------------------------------------------------------------------------------------------
    if(kn==1)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_base_2_alone_large';
    elseif(kn==2)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_base_2_large';
    elseif(kn==3)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_Ax_large';
    elseif(kn==4)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large';
    elseif(kn==5)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_noini_L8di_8_du02'; %<-- this is in reality L=4.
    elseif(kn==6)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_base_2_large_Bg02';
        %-----------------------------------------------------------------------------------------------------------------------
        %  Cyclotron frequency runs and short wave lengths
        %----------------------------------------------------------------------------------------------------------------------
    elseif(kn==7)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_Omc1';
    elseif(kn==8)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB08_Omc1';
    elseif(kn==9)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_Omc1_kd1';
    elseif(kn==10)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB08_Omc1_kd1';
        %-----------------------------------------------------------------------------------------------------------------------
        %  plasma, cyclotron frequency, di, rho
        %----------------------------------------------------------------------------------------------------------------------
    elseif(kn==11)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_Omc1_kLd1';
    elseif(kn==12)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_Omc1_kLr1';
    elseif(kn==13)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_omp1_kLd1';
    elseif(kn==14)
        path = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/psc_harris_yz_lange_many_Ax_large_L4di_dB01_omp1_kLr1';
    end
    %-----------------------------------------------------------------------------------------------------------------------

    % For the scripts
    path_comp = '/Volumes/PSC_CORI_DATA/TESTS_2022/New_V_tests/runs_with_L_05/testing_dB/Data_comparison';
    path_s  = '/Users/jeffersson_agudelo/Documents/CB104_local_data/Matlab_Scripts_here/Scripts_spectra';
    path_s2 = '/Users/jeffersson_agudelo/Documents/CB104_local_data/Matlab_Scripts_here';
    %-----------------------------------------------------------------------------------------------------------------------

    %-----------------------------------------------------------------------------------------------------------------------
    % To save the plots
    path_rec_r = strcat(path,'/spectra/rec_r');
    path_rec_line = strcat(path,'/spectra/rec_line');
    path_rec_line_ByBzJx = strcat(path,'/spectra/rec_line/ByBzJx');

    if not(isfolder(path_rec_r))
        mkdir(path_rec_r)
    end
    if not(isfolder(path_rec_line))
        mkdir(path_rec_line)
    end
    if not(isfolder(path_rec_line_ByBzJx))
        mkdir(path_rec_line_ByBzJx)
    end
    %-----------------------------------------------------------------------------------------------------------------------

    cd(path)
    %--------------------------------------------------------------------------
    S = dir(fullfile(path,'pfd.*.h5'));
    N=numel(S); % number of files to use
    H=zeros(N);
    %--------------------------------------------------------------------------
    S2 = dir(fullfile(path,'pfd_moments.*.h5'));
    N2=numel(S2); % number of files to use
    H2=zeros(N2);
    %--------------------------------------------------------------------------

    %--------------------------------------------------------------------------
    %B are normalized to the background magnetic field
    B0=0.2;
    %n is normalise to the proton density n0=1
    n0=1;
    %Vi normalised to the proton alfven speed V_a=0.1c The alfven speed of
    %electrons is Vae=10Vai
    Vae=0.2;%0.2;
    Va=0.2;%0.2;
    %--------------------------------------------------------------------------
    nb_n0 =0.1;
    kb = 1.; mu0 =1.; c=1; q = 1;

    Vai=0.2;
    Vai_b=Vai/sqrt(nb_n0);
    Vae_b=Vae/sqrt(nb_n0);

    mime =1.;
    mi = 1.;
    me = 1. / mime; eps0=1.;
    omega_pi=1;
    Omega_e=Vai*sqrt(mime)*omega_pi;
    Omega_i=Omega_e / mime;
    TOmega_e=1/Omega_e;
    TOmega_i=1/Omega_i;
    omega_pe_Omega_ce=5;
    %--------------------------------------------------------------------------
    in=1;
    fileID =  S(in).name; %change the 1 per i
    %h5disp(fileID);
    info = h5info(fileID);
    EHJ_1st = info.Groups(16).Name;
    B=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'));
    ss=size(B);
    LZs=ss(3);
    clearvars B
    N_jn=N;

    % %--------------------------------------------------------------------
    % % Making a plot for B2 as a function of time to see the growth rate of
    % the instability
    % %--------------------------------------------------------------------

    in=1;
    fileID =  S(in).name; %change the 1 per i
    %h5disp(fileID);
    info = h5info(fileID);
    EHJ_1st = info.Groups(16).Name;
    B=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'));
    ss=size(B);
    LXs=ss(1); LYs=ss(2); LZs=ss(3);
    %--------------------------------------------------------------------------
    nx1=1;    nx2=LXs;
    ny1=1;    ny2=LYs;
    nz1=1;    nz2=LZs;

    px2 = nx2; py2 = ny2; pz2 = nz2;
    start = [nx1 ny1 nz1];
    count = [px2 py2 pz2];

    time_t_2=zeros(1,N);

    B2_n=zeros(1,N);
    E2_n=zeros(1,N);

    U_EM2_n=zeros(1,N);
    U_k_e_n=zeros(1,in);
    U_k_i_n=zeros(1,in);
    U_th_e_n=zeros(1,in);
    U_th_i_n=zeros(1,in);

    in = 1;

    for in=1:floor(N)

        %------------------------------------------------------------------
        disp(strcat('Computing step ...',S(in).name))
        fileID =  S(in).name; %change the 1 per i
        %h5disp(fileID);
        info = h5info(fileID);
        EHJ_1st = info.Groups(16).Name;
        grid_dt = info.Groups(20).Attributes;

        grid_length = info.Groups(17).Attributes;
        Lx=grid_length(4).Value(1);% - grid_length(3).Value(1);
        Ly=grid_length(4).Value(2);% - grid_length(3).Value(2);
        Lz=grid_length(4).Value(3);% - grid_length(3).Value(3);
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        %To make the coordinate transformation
        %------------------------------------------------------------------
        % Get the fiel name and remove the prt.
        stri = S(in).name;
        newStri = erase(stri,"pfd.");

        % load the field files
        Sm = dir(fullfile(path,'pfd_moments.*.h5'));
        Nf=numel(Sm); % number of files to use

        %The idea is to find the index that corresponds to the file that has
        %the same name as in the prt info
        Nff = {Sm.name};
        Xff = contains(Nff,num2str(newStri));
        jjn=find(Xff==1); % this finds the index
        %Nff{Xff}
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        disp(strcat('Computing step ...',S2(jjn).name))
        fileID2 =  S2(jjn).name; %change the 1 per i
        %h5disp(fileID2);
        info2 = h5info(fileID2);
        moments_1st = info2.Groups(1).Name;
        %----------------------------------------------------------------------

        %------------------------------------------------------------------
        Bx=h5read(fileID,strcat(EHJ_1st,'/hx_fc/p0/3d'),start,count);
        By=h5read(fileID,strcat(EHJ_1st,'/hy_fc/p0/3d'),start,count);
        Bz=h5read(fileID,strcat(EHJ_1st,'/hz_fc/p0/3d'),start,count);
        Bx2 = Bx.^2; By2 = By.^2; Bz2 = Bz.^2;
        B2 = mean((Bx2 + By2 + Bz2),'all'); % it seems the total magnetic field goes
        clearvars Bx Bx2 By By2 Bz Bz2
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        Ex=h5read(fileID,strcat(EHJ_1st,'/ex_ec/p0/3d'),start,count);
        Ey=h5read(fileID,strcat(EHJ_1st,'/ey_ec/p0/3d'),start,count);
        Ez=h5read(fileID,strcat(EHJ_1st,'/ez_ec/p0/3d'),start,count);
        Ex2 = Ex.^2; Ey2 = Ey.^2; Ez2 = Ez.^2;
        E2 = mean((Ex2 + Ey2 + Ez2),'all'); % it seems the total magnetic field goes
        clearvars Ex Ex2 Ey Ey2 Ez Ez2
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        p_e_up{1,1}=h5read(fileID2,strcat(moments_1st,'/px_e_UP/p0/3d'),start,count);
        p_e_up{1,2}=h5read(fileID2,strcat(moments_1st,'/py_e_UP/p0/3d'),start,count);
        p_e_up{1,3}=h5read(fileID2,strcat(moments_1st,'/pz_e_UP/p0/3d'),start,count);

        p_i_up{1,1}=h5read(fileID2,strcat(moments_1st,'/px_i_UP/p0/3d'),start,count);
        p_i_up{1,2}=h5read(fileID2,strcat(moments_1st,'/py_i_UP/p0/3d'),start,count);
        p_i_up{1,3}=h5read(fileID2,strcat(moments_1st,'/pz_i_UP/p0/3d'),start,count);

        p_e_ba{1,1}=h5read(fileID2,strcat(moments_1st,'/px_e_BA/p0/3d'),start,count);
        p_e_ba{1,2}=h5read(fileID2,strcat(moments_1st,'/py_e_BA/p0/3d'),start,count);
        p_e_ba{1,3}=h5read(fileID2,strcat(moments_1st,'/pz_e_BA/p0/3d'),start,count);

        p_i_ba{1,1}=h5read(fileID2,strcat(moments_1st,'/px_i_BA/p0/3d'),start,count);
        p_i_ba{1,2}=h5read(fileID2,strcat(moments_1st,'/py_i_BA/p0/3d'),start,count);
        p_i_ba{1,3}=h5read(fileID2,strcat(moments_1st,'/pz_i_BA/p0/3d'),start,count);
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        n_e_up0=h5read(fileID2,strcat(moments_1st,'/rho_e_UP/p0/3d'),start,count);
        n_i_up0=h5read(fileID2,strcat(moments_1st,'/rho_i_UP/p0/3d'),start,count);
        n_e_up0=-1.*n_e_up0;
        n_e_ba0=h5read(fileID2,strcat(moments_1st,'/rho_e_BA/p0/3d'),start,count);
        n_i_ba0=h5read(fileID2,strcat(moments_1st,'/rho_i_BA/p0/3d'),start,count);
        n_e_ba0=-1.*n_e_ba0;
        n_e0=(n_e_up0 + n_e_ba0)./1;
        n_i0=(n_i_up0 + n_i_ba0)./1;

        n_e0(n_e0==0)=1e-20;
        n_i0(n_i0==0)=1e-20;
        n_e_up0(n_e_up0==0)=1e-20;
        n_i_up0(n_i_up0==0)=1e-20;
        n_e_ba0(n_e_ba0==0)=1e-20;
        n_i_ba0(n_i_ba0==0)=1e-20;
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        p_e_up{1,1}=p_e_up{1,1}./n_e_up0;
        p_e_up{1,2}=p_e_up{1,2}./n_e_up0;
        p_e_up{1,3}=p_e_up{1,3}./n_e_up0;

        p_i_up{1,1}=p_i_up{1,1}./n_i_up0;
        p_i_up{1,2}=p_i_up{1,2}./n_i_up0;
        p_i_up{1,3}=p_i_up{1,3}./n_i_up0;

        p_e_ba{1,1}=p_e_ba{1,1}./n_e_ba0;
        p_e_ba{1,2}=p_e_ba{1,2}./n_e_ba0;
        p_e_ba{1,3}=p_e_ba{1,3}./n_e_ba0;

        p_i_ba{1,1}=p_i_ba{1,1}./n_i_ba0;
        p_i_ba{1,2}=p_i_ba{1,2}./n_i_ba0;
        p_i_ba{1,3}=p_i_ba{1,3}./n_i_ba0;
        %------------------------------------------------------------------

        % this has to be here because it is after the correction dividing by n
        %------------------------------------------------------------------
        p_e{1,1}=(p_e_up{1,1} + p_e_ba{1,1})./1;
        p_e{1,2}=(p_e_up{1,2} + p_e_ba{1,2})./1;
        p_e{1,3}=(p_e_up{1,3} + p_e_ba{1,3})./1;

        p_i{1,1}=(p_i_up{1,1} + p_i_ba{1,1})./1;
        p_i{1,2}=(p_i_up{1,2} + p_i_ba{1,2})./1;
        p_i{1,3}=(p_i_up{1,3} + p_i_ba{1,3})./1;
        %------------------------------------------------------------------
        
        %------------------------------------------------------------------
        v_e=cell(1,3);
        v_i=cell(1,3);
        v_e_up=cell(1,3);
        v_i_up=cell(1,3);
        v_e_ba=cell(1,3);
        v_i_ba=cell(1,3);
        for i=1:3
            v_e{1,i} = (p_e{1,i} .* c ./ sqrt(c^2 .* me^2 + p_e{1,i}.^2)); % Do I need to do this normalization by VA2c
            v_i{1,i} = (p_i{1,i} .* c ./ sqrt(c^2 .* mi^2 + p_i{1,i}.^2));
            v_e_up{1,i} = (p_e_up{1,i} .* c ./ sqrt(c^2 .* me^2 + p_e_up{1,i}.^2));
            v_i_up{1,i} = (p_i_up{1,i} .* c ./ sqrt(c^2 .* mi^2 + p_i_up{1,i}.^2));
            v_e_ba{1,i} = (p_e_ba{1,i} .* c ./ sqrt(c^2 .* me^2 + p_e_ba{1,i}.^2));
            v_i_ba{1,i} = (p_i_ba{1,i} .* c ./ sqrt(c^2 .* mi^2 + p_i_ba{1,i}.^2));
        end
        clearvars p_i p_e p_i_up p_e_up p_i_ba p_e_ba
        %------------------------------------------------------------------

        %------------------------------------------------------------------        
        v_ex = v_e{1,1};
        v_ey = v_e{1,2};
        v_ez = v_e{1,3};

        v_ix = v_i{1,1};
        v_iy = v_i{1,2};
        v_iz = v_i{1,3};

        v_i_upx = v_i_up{1,1};
        v_i_upy = v_i_up{1,2};
        v_i_upz = v_i_up{1,3};

        v_e_upx = v_e_up{1,1};
        v_e_upy = v_e_up{1,2};
        v_e_upz = v_e_up{1,3};

        v_e_bax = v_e_ba{1,1};
        v_e_bay = v_e_ba{1,2};
        v_e_baz = v_e_ba{1,3};

        v_i_bax = v_i_ba{1,1};
        v_i_bay = v_i_ba{1,2};
        v_i_baz = v_i_ba{1,3};
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        Txx_e_up=h5read(fileID2,strcat(moments_1st,'/txx_e_UP/p0/3d'),start,count);
        Tyy_e_up=h5read(fileID2,strcat(moments_1st,'/tyy_e_UP/p0/3d'),start,count);
        Tzz_e_up=h5read(fileID2,strcat(moments_1st,'/tzz_e_UP/p0/3d'),start,count);
        Txy_e_up=h5read(fileID2,strcat(moments_1st,'/txy_e_UP/p0/3d'),start,count);
        Txz_e_up=h5read(fileID2,strcat(moments_1st,'/tzx_e_UP/p0/3d'),start,count);
        Tyz_e_up=h5read(fileID2,strcat(moments_1st,'/tyz_e_UP/p0/3d'),start,count);

        Txx_i_up=h5read(fileID2,strcat(moments_1st,'/txx_i_UP/p0/3d'),start,count);
        Tyy_i_up=h5read(fileID2,strcat(moments_1st,'/tyy_i_UP/p0/3d'),start,count);
        Tzz_i_up=h5read(fileID2,strcat(moments_1st,'/tzz_i_UP/p0/3d'),start,count);
        Txy_i_up=h5read(fileID2,strcat(moments_1st,'/txy_i_UP/p0/3d'),start,count);
        Txz_i_up=h5read(fileID2,strcat(moments_1st,'/tzx_i_UP/p0/3d'),start,count);
        Tyz_i_up=h5read(fileID2,strcat(moments_1st,'/tyz_i_UP/p0/3d'),start,count);

        Txx_e_ba=h5read(fileID2,strcat(moments_1st,'/txx_e_BA/p0/3d'),start,count);
        Tyy_e_ba=h5read(fileID2,strcat(moments_1st,'/tyy_e_BA/p0/3d'),start,count);
        Tzz_e_ba=h5read(fileID2,strcat(moments_1st,'/tzz_e_BA/p0/3d'),start,count);
        Txy_e_ba=h5read(fileID2,strcat(moments_1st,'/txy_e_BA/p0/3d'),start,count);
        Txz_e_ba=h5read(fileID2,strcat(moments_1st,'/tzx_e_BA/p0/3d'),start,count);
        Tyz_e_ba=h5read(fileID2,strcat(moments_1st,'/tyz_e_BA/p0/3d'),start,count);

        Txx_i_ba=h5read(fileID2,strcat(moments_1st,'/txx_i_BA/p0/3d'),start,count);
        Tyy_i_ba=h5read(fileID2,strcat(moments_1st,'/tyy_i_BA/p0/3d'),start,count);
        Tzz_i_ba=h5read(fileID2,strcat(moments_1st,'/tzz_i_BA/p0/3d'),start,count);
        Txy_i_ba=h5read(fileID2,strcat(moments_1st,'/txy_i_BA/p0/3d'),start,count);
        Txz_i_ba=h5read(fileID2,strcat(moments_1st,'/tzx_i_BA/p0/3d'),start,count);
        Tyz_i_ba=h5read(fileID2,strcat(moments_1st,'/tyz_i_BA/p0/3d'),start,count);

        Pij_i_ba=cell(3,3);
        Pij_e_ba=cell(3,3);
        Pij_i_up=cell(3,3);
        Pij_e_up=cell(3,3);
        %------------------------------------------------------------------
        
        %------------------------------------------------------------------
        % Make the tensor [3, 3] for the ions
        Pij_i_ba{1,1}=Txx_i_ba; Pij_i_ba{1,2}=Txy_i_ba; Pij_i_ba{1,3}=Txz_i_ba;
        Pij_i_ba{2,1}=Txy_i_ba; Pij_i_ba{2,2}=Tyy_i_ba; Pij_i_ba{2,3}=Tyz_i_ba;
        Pij_i_ba{3,1}=Txz_i_ba; Pij_i_ba{3,2}=Tyz_i_ba; Pij_i_ba{3,3}=Tzz_i_ba;
        clearvars Txx_i_ba Txy_i_ba Txz_i_ba Tyy_i_ba Tyz_i_ba Tzz_i_ba
        % Make the tensor [3, 3] for the electrons
        Pij_e_ba{1,1}=Txx_e_ba; Pij_e_ba{1,2}=Txy_e_ba; Pij_e_ba{1,3}=Txz_e_ba;
        Pij_e_ba{2,1}=Txy_e_ba; Pij_e_ba{2,2}=Tyy_e_ba; Pij_e_ba{2,3}=Tyz_e_ba;
        Pij_e_ba{3,1}=Txz_e_ba; Pij_e_ba{3,2}=Tyz_e_ba; Pij_e_ba{3,3}=Tzz_e_ba;
        clearvars Txx_e_ba Txy_e_ba Txz_e_ba Tyy_e_ba Tyz_e_ba Tzz_e_ba
        %------------------------------------------------------------------
        % Make the tensor [3, 3] for the ions
        Pij_i_up{1,1}=Txx_i_up; Pij_i_up{1,2}=Txy_i_up; Pij_i_up{1,3}=Txz_i_up;
        Pij_i_up{2,1}=Txy_i_up; Pij_i_up{2,2}=Tyy_i_up; Pij_i_up{2,3}=Tyz_i_up;
        Pij_i_up{3,1}=Txz_i_up; Pij_i_up{3,2}=Tyz_i_up; Pij_i_up{3,3}=Tzz_i_up;
        clearvars Txx_i_up Txy_i_up Txz_i_up Tyy_i_up Tyz_i_up Tzz_i_up
        % Make the tensor [3, 3] for the electrons
        Pij_e_up{1,1}=Txx_e_up; Pij_e_up{1,2}=Txy_e_up; Pij_e_up{1,3}=Txz_e_up;
        Pij_e_up{2,1}=Txy_e_up; Pij_e_up{2,2}=Tyy_e_up; Pij_e_up{2,3}=Tyz_e_up;
        Pij_e_up{3,1}=Txz_e_up; Pij_e_up{3,2}=Tyz_e_up; Pij_e_up{3,3}=Tzz_e_up;
        clearvars Txx_e_up Txy_e_up Txz_e_up Tyy_e_up Tyz_e_up Tzz_e_up
        %------------------------------------------------------------------

        % This is to get the central momment pressure.
        %------------------------------------------------------------------
        % % PPij_i=cell(3,3);
        % % PPij_e=cell(3,3);
        PPij_i_ba=cell(3,3);
        PPij_e_ba=cell(3,3);
        PPij_i_up=cell(3,3);
        PPij_e_up=cell(3,3);

        for i=1:3
            for j=1:3
                if(isempty(Pij_i_ba{i,j}) == 1) % This is where if P_ba is zero, this should be changed.
                    continue
                end
                PPij_i_ba{i,j} = Pij_i_ba{i,j} - 1.*n_i_ba0.*mi.*v_i_ba{1,i}.*v_i_ba{1,j};
                PPij_e_ba{i,j} = Pij_e_ba{i,j} - 1.*n_e_ba0.*me.*v_e_ba{1,i}.*v_e_ba{1,j};
                PPij_i_up{i,j} = Pij_i_up{i,j} - 1.*n_i_up0.*mi.*v_i_up{1,i}.*v_i_up{1,j};
                PPij_e_up{i,j} = Pij_e_up{i,j} - 1.*n_e_up0.*me.*v_e_up{1,i}.*v_e_up{1,j};
            end
        end

        % This is just to rename the variable
        Pij_i_ba = PPij_i_ba;
        Pij_e_ba = PPij_e_ba;
        Pij_i_up = PPij_i_up;
        Pij_e_up = PPij_e_up;

        clearvars v_i_up v_e_up v_i_ba v_e_ba %<----
        clearvars Txx_e_ba Txx_e_up Tyy_e_ba Tyy_e_up Tzz_e_ba Tzz_e_up
        clearvars Txy_e_ba Txy_e_up Txz_e_ba Txz_e_up Tyz_e_ba Tyz_e_up
        clearvars Txx_i_ba Txx_i_up Tyy_i_ba Tyy_i_up Tzz_i_ba Tzz_i_up
        clearvars Txy_i_ba Txy_i_up Txz_i_ba Txz_i_up Tyz_i_ba Tyz_i_up
        clearvars PPij_i_ba PPij_e_ba PPij_i_up PPij_e_up
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        dt=double(grid_dt(15).Value);
        str = string(S(in).name);
        newStr = extractBetween(str,"pfd.","_p000000.h5");
        N_steps = str2double(newStr);
        time_t = dt*N_steps;
        time_t_2_Omega=time_t./omega_pe_Omega_ce;
        time_t_2(1,in)=time_t_2_Omega;
        %------------------------------------------------------------------

        %------------------------------------------------------------------
        U_k_e = 0.5 .* n_e_ba0 .* (v_ex.^2 + v_ey.^2 + v_ez.^2);
        U_k_i = 0.5 .* n_i_ba0 .* (v_ix.^2 + v_iy.^2 + v_iz.^2);

        U_th_e = 0.5 .* (Pij_e_ba{1,1} + Pij_e_up{1,1} + ...
            Pij_e_ba{2,2} + Pij_e_up{2,2} + ...
            Pij_e_ba{3,3} + Pij_e_up{3,3});
        U_th_i = 0.5 .* (Pij_i_ba{1,1} + Pij_i_up{1,1} + ...
            Pij_i_ba{2,2} + Pij_i_up{2,2} + ...
            Pij_i_ba{3,3} + Pij_i_up{3,3});

        U_k_e_m = mean(U_k_e,'all');
        U_k_i_m = mean(U_k_i,'all');
        U_th_e_m = mean(U_th_e,'all');
        U_th_i_m = mean(U_th_i,'all');

        B2_n(1,in) = B2;
        E2_n(1,in) = E2;

        U_EM2_n(1,in) = (B2 + E2)/2;
        U_k_e_n(1,in) = U_k_e_m;
        U_k_i_n(1,in) = U_k_i_m;
        U_th_e_n(1,in) = U_th_e_m;
        U_th_i_n(1,in) = U_th_i_m;        
        %------------------------------------------------------------------        
        clearvars Pij_i* Pij_e* v_* n_* ...
            U_k_e U_k_i U_th_e U_th_i

        cd(path)

    end
    % Estimating the growth rates
    %--------------------------------------------------------------------------
    %sigma_g=25;
    % This is to find the growth rate of the maximum value
    %--------------------------------------------------------------------------
    % First smooth the curve

    %--------------------------------------------------------------------------
    B2_n_T{1,kn} = B2_n; 
    E2_n_T{1,kn} = E2_n;
    U_EM2_n_T{1,kn} = U_EM2_n;
    U_k_e_n_T{1,kn} = U_k_e_n;
    U_k_i_n_T{1,kn} = U_k_i_n;
    U_th_e_n_T{1,kn} = U_th_e_n;
    U_th_i_n_T{1,kn} = U_th_i_n;
    time_t_2_T{kn} = time_t_2;

    cd(path)
    save('energy_densities_response.mat',...
        'B2_n_T','E2_n_T','U_EM2_n_T','U_k_e_n_T','U_k_i_n_T','U_th_e_n_T','U_th_i_n_T','time_t_2_T')

end




